# Copiar este archivo a .env en la raíz de sensacine-backend y ajustar los valores reales.
# NUNCA subir el archivo .env real a git (ya está en .gitignore).

NODE_ENV=development
PORT=3000

# Ajusta usuario, password, host, puerto y nombre de base de datos según tu instalación local o remota de PostgreSQL.
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/sensacine?schema=public"

# Usado para firmar JWT en el módulo de login.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Costo del hash de bcrypt para las contraseñas. 10 es un buen default para desarrollo.
BCRYPT_SALT_ROUNDS=10

