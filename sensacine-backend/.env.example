# Copiar este archivo a .env en la raíz de sensacine-backend y ajustar los valores reales.
# NUNCA subir el archivo .env real a git (ya está en .gitignore).

NODE_ENV=development
PORT=3000

# Ajusta usuario, password, host, puerto y nombre de base de datos según tu instalación local o remota de PostgreSQL.
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/sensacine?schema=public"

# Usado para firmar JWT en el módulo de login.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Costo del hash de bcrypt para las contraseñas. 10 es un buen default para desarrollo.
BCRYPT_SALT_ROUNDS=10

# URL pública del frontend, usada en los enlaces de los correos (invitación a reseñar la película).
FRONTEND_URL=http://localhost:5173

# Correo de confirmación de reservas (opcional; sin esto la app arranca pero no envía correos).
#
# OPCIÓN A (recomendada): API de Gmail por HTTPS. Funciona aunque tu red bloquee los puertos de correo (SMTP).
# Si defines las tres variables GMAIL_*, se usa esta opción y se ignora SMTP. Pasos en el README.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM="SensaCine <tu_correo@gmail.com>"

# OPCIÓN B: SMTP (solo si tu red permite los puertos 587/465).
# Gmail: crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
# Para probar sin enviar nada real puedes usar las credenciales de https://ethereal.email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=
